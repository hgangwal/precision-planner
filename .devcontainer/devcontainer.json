{
  "name": "Precision Planner",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install gradio==6.31.0 pytest==9.2.0",
  "postAttachCommand": "python app.py",
  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": {
      "label": "Dashboard",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
